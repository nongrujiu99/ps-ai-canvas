# 第三方（OpenAI 兼容）渠道配置
#
# 日常使用不需要改这个文件：渠道可以在面板「设置 → 生成渠道」里直接切换和填写。
# 这里只用于「部署时锁定渠道」——想把渠道固定死、不让面板改，就填好下面的值
# 并加上 STUDIO_LOCK_PROVIDER=1。
#
# 锁定后执行：npm run start:openai
#
# 以 gpt-best 这类中转为例，Base URL 在它的后台「API KEYS / 令牌」页面里，
# 形如 https://xxx.com/v1（没写 /v1 也行，程序会自动补）。

STUDIO_PROVIDER=openai
STUDIO_LOCK_PROVIDER=1
STUDIO_BASE_URL=
STUDIO_API_KEY=

# ---------- 方案 A：gpt-image 系列（支持 mask，能精确限定重绘区） ----------
# 优点：edits 接口带 mask，扩图时原照片区域模型碰不到，从机制上不会「背景被重绘」。
# 缺点：输出档位少（1024²/1024×1536/1536×1024），3074 宽的画布要缩一半再放大。
STUDIO_MODEL=gpt-image-2
# STUDIO_SIZES=1536x1024,1024x1536,1024x1024

# ---------- 方案 B：Gemini 系（Nano-banana，4K，榜单第一梯队） ----------
# 优点：4K 档，画布基本不用缩；指令编辑能力强。
# 缺点：不认像素尺寸，只认档位 + 宽高比；也不支持 mask，靠提示词约束。
# 用法：把下面两行取消注释，并注释掉上面的 STUDIO_MODEL。
# STUDIO_MODEL=gemini-3.1-flash-image-preview
# STUDIO_SIZE_MODE=tier
# 可选：强制宽高比。留空则沿用输入图的比例（推荐留空）。
# STUDIO_ASPECT_RATIO=4:3

# ---------- 方案 C：Seedream 5.0 Pro（国内最强，自定义像素尺寸） ----------
# 它的图生图走 /v1/images/generations + image 数组，和 edits 不是一套协议，
# 当前版本还没适配；等 A/B 都试过再决定要不要接。

# ---------- 通用可选 ----------
# 单次送图像素上限，默认 4194304（2048×2048）。渠道支持 4K 可调到 16777216。
# STUDIO_MAX_PIXELS=4194304

# 字段名覆盖（少数中转把 size 叫别的东西时用）
# STUDIO_SIZE_PARAM=size
# STUDIO_TIER_PARAM=image_size

# 单次请求等待上限（毫秒），默认 300000（5 分钟）。
# 中转站是同步出图，画布越大越慢；2600×2560 常见要两三分钟，
# 调到 120000 会把正常任务掐断，然后报成「超时」。
# STUDIO_REQUEST_TIMEOUT_MS=300000
# 整个任务（含排队轮询）的上限，默认 600000（10 分钟）。
# STUDIO_JOB_TIMEOUT_MS=600000

# 本地服务端口，默认 32145
# STUDIO_PORT=32145
