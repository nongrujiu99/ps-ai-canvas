{
  "name": "studio-local-service",
  "version": "0.1.0",
  "private": true,
  "description": "Local image service for the Photoshop AI canvas plugin",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/main.js",
    "start:openai": "node scripts/start-openai.js",
    "probe": "node scripts/probe-provider.js",
    "start:proxy": "node --use-env-proxy src/main.js"
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
